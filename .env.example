SECRET_KEY=change-me
# Local development (default)
DATABASE_URL=sqlite:///local.db

# Supabase Postgres (replace DATABASE_URL with your Supabase string when ready)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Storage (for cover image uploads from the admin form)
# Create a public bucket (example: "covers") and set:
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=covers

# One-time bootstrap admin (local/dev only)
BOOTSTRAP_ADMIN_TOKEN=local-bootstrap-token
ADMIN_EMAIL=admin@cnb.local
ADMIN_PASSWORD=change-me
